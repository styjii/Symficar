<form method="post" action="{{ path('app_assurance_delete', {'id': assurance.id}) }}" class="mt-4" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assurance.id) }}">
    <button class="btn btn-error btn-outline btn-sm">Delete</button>
</form>
