{% extends 'base.html.twig' %}

{% block title %}Voiture{% endblock %}

{% block body %}
    <div class="p-6 max-w-3xl mx-auto">
        <h1 class="text-2xl font-bold mb-4">{{ voiture.marque }} {{ voiture.modele }}</h1>

        {% if assurances_expirant_bientot|length > 0 %}
            <div role="alert" class="alert alert-warning mb-4">
                <span>⚠️ {{ assurances_expirant_bientot|length }} assurance(s) arrive(nt) à expiration prochainement !</span>
            </div>
            <ul class="mb-6 space-y-1">
                {% for assurance in assurances_expirant_bientot %}
                    <li class="text-sm">{{ assurance.compagnie }} (contrat {{ assurance.numeroContrat }}) — expire le {{ assurance.dateFin|date('d/m/Y') }}</li>
                {% endfor %}
            </ul>
        {% endif %}

        <div class="card bg-base-100 shadow mb-6">
            <div class="card-body">
                <table class="table">
                    <tbody>
                        <tr>
                            <th class="w-40">Id</th>
                            <td>{{ voiture.id }}</td>
                        </tr>
                        <tr>
                            <th>Marque</th>
                            <td>{{ voiture.marque }}</td>
                        </tr>
                        <tr>
                            <th>Modele</th>
                            <td>{{ voiture.modele }}</td>
                        </tr>
                        <tr>
                            <th>Immatriculation</th>
                            <td>{{ voiture.immatriculation }}</td>
                        </tr>
                        <tr>
                            <th>Annee</th>
                            <td>{{ voiture.annee }}</td>
                        </tr>
                        <tr>
                            <th>Proprietaire</th>
                            <td>
                                {% if voiture.proprietaire %}
                                    <a href="{{ path('app_personne_show', {'id': voiture.proprietaire.id}) }}" class="link link-primary">
                                        {{ voiture.proprietaire.nom }} {{ voiture.proprietaire.prenom }}
                                    </a>
                                {% else %}
                                    Aucun propriétaire
                                {% endif %}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <h3 class="text-lg font-semibold mb-3">Historique des assurances</h3>
        {% if voiture.assurances|length > 0 %}
            <ul class="space-y-2 mb-6">
                {% for assurance in voiture.assurances %}
                    <li class="card bg-base-100 shadow-sm p-4 flex-row justify-between items-center">
                        <span>
                            {{ assurance.compagnie }} — du {{ assurance.dateDebut|date('d/m/Y') }}
                            au {{ assurance.dateFin|date('d/m/Y') }}
                            ({{ assurance.montant }} €)
                        </span>
                        {% if assurance.active %}
                            <span class="badge badge-success">active</span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-base-content/60 mb-6">Aucune assurance enregistrée pour cette voiture.</p>
        {% endif %}

        <div class="flex gap-3">
            <a href="{{ path('app_voiture_index') }}" class="btn btn-ghost">back to list</a>
            <a href="{{ path('app_voiture_edit', {'id': voiture.id}) }}" class="btn btn-outline">edit</a>
        </div>

        {{ include('voiture/_delete_form.html.twig') }}
    </div>
{% endblock %}
