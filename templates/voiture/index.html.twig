{% extends 'base.html.twig' %}

{% block title %}Voiture index{% endblock %}

{% block body %}
    <div class="p-6 max-w-6xl mx-auto">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold">Voiture index</h1>
            <a href="{{ path('app_voiture_new') }}" class="btn btn-primary">Create new</a>
        </div>

        <div class="overflow-x-auto bg-base-100 rounded-box shadow">
            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Marque</th>
                        <th>Modele</th>
                        <th>Immatriculation</th>
                        <th>Annee</th>
                        <th class="text-right">actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for voiture in voitures %}
                    <tr class="hover">
                        <td>{{ voiture.id }}</td>
                        <td>{{ voiture.marque }}</td>
                        <td>{{ voiture.modele }}</td>
                        <td>{{ voiture.immatriculation }}</td>
                        <td>{{ voiture.annee }}</td>
                        <td class="text-right space-x-2">
                            <a href="{{ path('app_voiture_show', {'id': voiture.id}) }}" class="btn btn-sm btn-ghost">show</a>
                            <a href="{{ path('app_voiture_edit', {'id': voiture.id}) }}" class="btn btn-sm btn-ghost">edit</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-base-content/50 py-8">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
