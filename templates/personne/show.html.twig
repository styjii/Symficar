{% extends 'base.html.twig' %}

{% block title %}Personne{% endblock %}

{% block body %}
    <h1>{{ personne.nom }} {{ personne.prenom }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ personne.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ personne.nom }}</td>
            </tr>
            <tr>
                <th>Prenom</th>
                <td>{{ personne.prenom }}</td>
            </tr>
            <tr>
                <th>Telephone</th>
                <td>{{ personne.telephone }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ personne.email }}</td>
            </tr>
            <tr>
                <th>NumeroPermis</th>
                <td>{{ personne.numeroPermis }}</td>
            </tr>
        </tbody>
    </table>

    <h3>Parc automobile</h3>
    {% if personne.voitures|length > 0 %}
        <ul>
            {% for voiture in personne.voitures %}
                <li>
                    <a href="{{ path('app_voiture_show', {'id': voiture.id}) }}">
                        {{ voiture.marque }} {{ voiture.modele }} ({{ voiture.immatriculation }})
                    </a>
                    {% set assuranceActive = voiture.assuranceActive %}
                    {% if assuranceActive %}
                        — assurée jusqu'au {{ assuranceActive.dateFin|date('d/m/Y') }}
                    {% else %}
                        — <span class="text-danger">aucune assurance active</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p>Aucune voiture enregistrée pour cette personne.</p>
    {% endif %}

    <a href="{{ path('app_personne_index') }}">back to list</a>

    <a href="{{ path('app_personne_edit', {'id': personne.id}) }}">edit</a>

    {{ include('personne/_delete_form.html.twig') }}
{% endblock %}
