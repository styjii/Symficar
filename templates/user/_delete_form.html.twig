{% if user != app.user %}
    <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" class="mt-4" onsubmit="return confirm('Supprimer cet utilisateur ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
        <button class="btn btn-error btn-outline btn-sm">Supprimer</button>
    </form>
{% endif %}
