{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}
    <div class="p-6 max-w-4xl mx-auto">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold">Utilisateurs</h1>
            <a href="{{ path('app_user_new') }}" class="btn btn-primary">+ Nouvel utilisateur</a>
        </div>

        <div class="overflow-x-auto bg-base-100 rounded-box shadow">
            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Email</th>
                        <th>Rôles</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr class="hover">
                        <td>{{ user.id }}</td>
                        <td>{{ user.email }}</td>
                        <td>
                            {% for role in user.roles %}
                                <span class="badge {{ role == 'ROLE_ADMIN' ? 'badge-primary' : 'badge-ghost' }}">{{ role }}</span>
                            {% endfor %}
                        </td>
                        <td class="text-right">
                            <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-ghost">Modifier</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center text-base-content/50 py-8">Aucun utilisateur</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
