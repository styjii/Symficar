{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    <div class="min-h-[80vh] flex items-center justify-center p-6">
        <div class="card w-full max-w-sm bg-base-100 shadow">
            <div class="card-body">
                <h1 class="text-2xl font-bold mb-4 text-center">Connexion</h1>

                {% if error %}
                    <div role="alert" class="alert alert-error mb-4">
                        <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                    </div>
                {% endif %}

                {% if app.user %}
                    <div role="alert" class="alert alert-info mb-4">
                        <span>Vous êtes connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}" class="link">déconnexion</a></span>
                    </div>
                {% endif %}

                <form method="post" class="space-y-4">
                    <div class="form-control w-full">
                        <label for="inputEmail" class="label">
                            <span class="label-text">Email</span>
                        </label>
                        <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="input input-bordered w-full" autocomplete="email" required autofocus>
                    </div>

                    <div class="form-control w-full">
                        <label for="inputPassword" class="label">
                            <span class="label-text">Mot de passe</span>
                        </label>
                        <input type="password" name="password" id="inputPassword" class="input input-bordered w-full" autocomplete="current-password" required>
                    </div>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    <button class="btn btn-primary w-full" type="submit">
                        Se connecter
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
